{
  "name": "acme-orders-api",
  "version": "1.0.0",
  "description": "Acme Orders API — legacy Express 4 + Mongoose 6 sample app for UpgradePilot demos",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --forceExit"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "4.18.2",
    "mongoose": "6.12.3"
  },
  "devDependencies": {
    "jest": "27.5.1",
    "mongodb-memory-server": "8.16.0",
    "supertest": "6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "license": "MIT"
}
